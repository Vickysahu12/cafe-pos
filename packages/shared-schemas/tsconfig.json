{
  // FIX (2026-09-29): yeh package ab build hota hai (src → dist, CommonJS).
  // Pehle package.json ka "main" raw src/index.ts pe tha — `tsx` (dev) usse chala
  // leta tha, lekin production mein `node dist/server.js` .ts file require nahi
  // kar sakta → backend startup pe hi crash (ERR_MODULE_NOT_FOUND).
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
