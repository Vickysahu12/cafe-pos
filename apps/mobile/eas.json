{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.billraw.in/api/v1",
        "EXPO_PUBLIC_ORDER_URL": "https://order.billraw.in"
      },
      "pnpm": "12.0.0"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.billraw.in/api/v1",
        "EXPO_PUBLIC_ORDER_URL": "https://order.billraw.in"
      },
      "pnpm": "12.0.0"
    }
  },
  "submit": {
    "production": {}
  }
}
