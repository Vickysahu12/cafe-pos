generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────
// ENUMS
// ─────────────────────────────

enum Role {
  OWNER
  MANAGER
  CASHIER
  CHEF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  SPLIT
}

// ─────────────────────────────
// CORE MODELS
// ─────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]

  @@map("organizations")
}

model Outlet {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique // used in customer QR URL: /order/:slug
  address         String
  phone           String
  gstNumber       String?
  organizationId  String
  createdAt       DateTime @default(now())
  // ADDED (2026-10-05): REVIEW BOOSTER — Google Business Profile ka "write a review" link
  // (g.page/r/.../review). Owner app ki Settings se daalta hai; customer ko review page,
  // bill aur order-tracking pe "Rate us on Google" button isi link pe le jaata hai.
  googleReviewUrl String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  categories   Category[]
  products     Product[]
  tables       Table[]
  orders       Order[]
  auditLogs    AuditLog[]
  inventory    InventoryItem[]
  counters     OrderCounter[]
  feedback     Feedback[] // ADDED (2026-10-05)
  reviewStats  ReviewStat[] // ADDED (2026-10-05)

  @@index([organizationId])
  @@map("outlets")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  phone             String
  passwordHash      String
  role              Role
  outletId          String
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false) // ← naya field
  // DPDP Act, 2023 — timestamped proof that notice was shown and consent was
  // given for this user's own data. Set at Owner registration (from the
  // register.tsx consent checkbox). Null for staff accounts created by an
  // Owner/Manager via createStaff — those users haven't personally consented
  // yet, so this should be captured on the staff member's own first login
  // (tracked separately; do not backfill this with the creator's timestamp).
  consentAcceptedAt DateTime?
  createdAt         DateTime  @default(now())

  outlet          Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ordersCashiered Order[]             @relation("CashierOrders")
  auditLogs       AuditLog[]
  verifications   EmailVerification[] // ← naya relation
  refreshTokens   RefreshToken[]

  @@index([outletId])
  @@map("users")
}

// FIX (2026-09-29): ek hi OTP table ab do kaam karti hai — signup email verify
// aur "forgot password". `purpose` se dono ke OTP kabhi mix nahi hote (reset ka
// OTP email-verify mein kaam nahi karega aur ulta bhi).
enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model EmailVerification {
  id        String     @id @default(uuid())
  userId    String
  otpHash   String // OTP kabhi plain text store nahi hoga, hamesha hashed
  purpose   OtpPurpose @default(EMAIL_VERIFY)
  expiresAt DateTime // 10 minute expiry
  createdAt DateTime   @default(now())
  attempts  Int        @default(0) // ← naya: galat guesses ginta hai

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_verifications")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  outletId    String
  sortOrder   Int       @default(0)
  isAvailable Boolean   @default(true)
  // FIX (2026-09-29): "delete" = archive (soft delete). Purane orders ke
  // order_items product ko RESTRICT FK se point karte hain, isliye jis product
  // ka kabhi order hua ho usse DB se hata nahi sakte (bill history toot jaayegi).
  // archivedAt set = menu/billing/QR se gayab, lekin purane bills sahi dikhte hain.
  archivedAt  DateTime?

  outlet   Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([outletId])
  @@map("categories")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Float
  categoryId  String
  outletId    String
  isAvailable Boolean   @default(true)
  taxRate     Float     @default(0)
  isVeg       Boolean
  archivedAt  DateTime? // FIX (2026-09-29): soft delete, dekho Category.archivedAt

  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  outlet     Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]
  addons     ProductAddon[]
  orderItems OrderItem[]

  @@index([outletId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String @id @default(uuid())
  name      String // e.g. Small, Medium, Large
  price     Float
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductAddon {
  id        String @id @default(uuid())
  name      String // e.g. Extra Cheese
  price     Float
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_addons")
}

model Table {
  id          String      @id @default(uuid())
  tableNumber String
  capacity    Int
  status      TableStatus @default(AVAILABLE)
  outletId    String

  outlet Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([outletId])
  @@map("tables")
}

model Order {
  id             String         @id @default(uuid())
  orderNumber    Int // daily-reset sequence, see OrderCounter below
  outletId       String
  tableId        String?
  orderType      OrderType
  totalAmount    Float
  taxAmount      Float          @default(0)
  discountAmount Float          @default(0)
  netAmount      Float
  paymentStatus  PaymentStatus  @default(UNPAID)
  paymentMethod  PaymentMethod?
  orderStatus    OrderStatus    @default(PENDING)
  cashierId      String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  outlet  Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table   Table?      @relation(fields: [tableId], references: [id])
  cashier User?       @relation("CashierOrders", fields: [cashierId], references: [id])
  items   OrderItem[]

  @@index([outletId])
  @@index([outletId, createdAt]) // fast daily-summary queries
  @@map("orders")
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  notes      String?
  status     OrderItemStatus @default(PENDING)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// Solves the "daily-reset order number" problem — one row per outlet per day,
// incremented inside a transaction when a new order is created.
// Postgres has no native per-day-resetting sequence, so this is the reliable way.
model OrderCounter {
  id         String   @id @default(uuid())
  outletId   String
  date       DateTime @db.Date // just the date part, e.g. 2026-08-27
  lastNumber Int      @default(0)

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, date])
  @@map("order_counters")
}

model InventoryItem {
  id              String   @id @default(uuid())
  name            String
  outletId        String
  quantity        Float
  unit            String // e.g. "kg", "litres", "packets"
  lowStockAlertAt Float    @default(0) // Manager-set threshold
  updatedAt       DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@map("inventory_items")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  outletId  String
  action    String // e.g. "CANCEL_ORDER", "APPLY_DISCOUNT", "DELETE_ITEM", "CONSENT_ACCEPTED"
  metadata  Json?
  timestamp DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([outletId, timestamp])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // raw token kabhi store nahi hota, sirf HMAC hash
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────
// ADDED (2026-10-05): REVIEW BOOSTER
// ─────────────────────────────────────────────────────────

/// Customer ne review card / bill / tracking page se kahan se feedback diya
enum ReviewSource {
  CARD // counter pe rakha printed review card (QR)
  BILL // WhatsApp wala digital bill
  STATUS // QR order ka tracking page (served ke baad)
}

/// "Tell the owner privately" — customer ka private message, sirf Owner/Manager dekhte hain.
/// GOOGLE POLICY: yeh Google review ka RASTA NAHI rokta — Google button sabko dikhta hai,
/// yeh sirf ek extra option hai (review gating nahi). Phone/email kabhi store nahi karte.
model Feedback {
  id        String       @id @default(uuid())
  outletId  String
  message   String // max 500 chars (validation me)
  name      String? // optional, max 60
  orderId   String? // bill/tracking page se aaya ho to (same outlet ka verified)
  source    ReviewSource
  createdAt DateTime     @default(now())
  readAt    DateTime? // owner ne dekh liya → "new" badge hata

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, createdAt])
  @@map("feedback")
}

/// Din-wise ginti (OrderCounter jaisa ek row per cafe per IST din) — har scan ka alag
/// row nahi, taaki 1000 cafes pe bhi table chhota rahe. Atomic increment (upsert).
model ReviewStat {
  id           String   @id @default(uuid())
  outletId     String
  date         DateTime @db.Date // IST calendar day
  cardViews    Int      @default(0) // review card scan → review page khula
  googleClicks Int      @default(0) // kisi bhi jagah "Rate us on Google" tap

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, date])
  @@map("review_stats")
}
