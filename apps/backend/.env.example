# Backend environment — copy to .env and fill in. Validated at boot by src/config/env.ts
# (server refuses to start if anything required is missing).
# FIX (2026-09-29): this file was empty — a new machine / Render setup had no reference.

# Neon Postgres. DATABASE_URL = POOLED connection (hostname contains "-pooler").
# For 1000+ cafes keep connection_limit small per instance; pgbouncer does the pooling.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=10"
# DIRECT (non-pooled) URL — used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_REFRESH_SECRET is also the HMAC key for stored refresh tokens — rotating it logs everyone out.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Resend (email OTP). EMAIL_FROM must be on a domain verified in Resend,
# otherwise sandbox mode only delivers to the Resend account owner's inbox.
RESEND_API_KEY=""
EMAIL_FROM="no-reply@your-domain.com"

# Comma-separated browser origins allowed by CORS + Socket.io (customer web app).
# The native mobile app sends no Origin header and is always allowed.
ALLOWED_ORIGINS="http://localhost:3001"

PORT=3000
NODE_ENV=development
